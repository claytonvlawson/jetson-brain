# advisor.service -- keep the public "Ask the advisor" endpoint (advisor_server.py)
# running on the Jetson across reboots and crashes. advisor-funnel-jetson.sh
# already assumes `systemctl start advisor`; this is that unit.
#
# The server binds 127.0.0.1:8000 only. Public exposure is a separate concern
# handled by Tailscale Funnel (advisor-funnel-jetson.sh), so this unit needs
# Ollama but not tailscaled.
#
# Install (run once on the Jetson, needs sudo):
#   sudo cp /mnt/nvme/brain/advisor.env.example /etc/advisor.env
#   sudo nano /etc/advisor.env        # set ADVISOR_TOKEN to a real secret
#   sudo chmod 600 /etc/advisor.env
#   sudo cp /mnt/nvme/brain/advisor.service /etc/systemd/system/advisor.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now advisor
#   systemctl status advisor          # confirm it is active
#   curl -s localhost:8000/health     # confirm it answers
#
# The same ADVISOR_TOKEN value must be set as JETSON_ADVISOR_TOKEN in Vercel.

[Unit]
Description=learnwithclay.ai advisor endpoint (RAG over the vault, bound to localhost)
Documentation=file:/mnt/nvme/brain/advisor_server.py
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
# MUST run as snowbeach: brain.py's deps are installed with `pip install --user`,
# so root would not find them on the import path.
User=snowbeach
WorkingDirectory=/mnt/nvme/brain
# The token (and any other ADVISOR_* overrides) live here, not in this unit, so
# the secret stays out of the repo. Required, not optional: if it is missing the
# service fails to start rather than silently running an unauthenticated public
# endpoint.
EnvironmentFile=/etc/advisor.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/nvme/brain/advisor_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
