obsidian_vectors.json
# Mac-side index. Named without a trailing slash on purpose: a linked git
# worktree symlinks this rather than copying 6.6M of build artifact, and a
# 'index-mac/' pattern would not match a symlink. Until now it stayed quiet
# only because its sole content (bm25.pkl) matches *.pkl above.
index-mac
# Jetson's live index, staged on the Mac for the Spark parity run. Same
# trailing-slash-free reasoning as index-mac above.
index-jetson

# Secrets / env
.env
.env.*
!.env.example

# OS cruft
.DS_Store

advisor.env.local
brave.env.local
groq.env.local
anthropic.env.local
.venv-asl/

