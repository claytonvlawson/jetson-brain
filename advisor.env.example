# advisor.env.example -- copy to /etc/advisor.env on the Jetson and fill in.
# Read by advisor.service (EnvironmentFile). Keep the real file chmod 600.
#
#   sudo cp advisor.env.example /etc/advisor.env && sudo chmod 600 /etc/advisor.env
#   # generate a secret:  openssl rand -hex 32

# Shared secret. MUST match JETSON_ADVISOR_TOKEN in the Vercel project.
ADVISOR_TOKEN=replace-with-openssl-rand-hex-32

# Optional overrides (defaults shown; safe to leave commented out):
# ADVISOR_MODEL=llama3.2:3b
# ADVISOR_WEB=0
# ADVISOR_LOG_DIR=/mnt/nvme/brain/advisor
# ADVISOR_PORT=8000
