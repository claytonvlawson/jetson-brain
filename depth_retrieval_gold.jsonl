# Retrieval labels for the SCHOLAR depth facets: one row per language-deprivation
# facet that a depth answer has to cover, mapped to the note(s) that actually hold
# the material.
#
# Scored by the UNMODIFIED eval_retrieval.py (no judge, deterministic, ~40s per
# arm). Purpose: catch a bad facet query cheaply, before it costs a 900s judged
# run. If a facet's note is not in the retrieval window here, no amount of
# prompt work in the scholar persona can make the answer deep on that facet.
#
# LABELING METHOD. Same discipline as retrieval_gold.jsonl: candidates were
# proposed from the FACT text in depth_gold.jsonl, never from the question
# wording (the wording is the thing under test), and every proposal was
# confirmed by reading the note and finding the fact stated in it.
#
# persona is set to "scholar" on every row. eval_retrieval.py:115 reads
# row.get("persona","default") and warns (never fails) on an unknown value;
# "scholar" is in its KNOWN_PERSONAS tuple, so these rows run clean.
#
# label_method values:
#   body    the fact is stated in the note body, verified line read
#   concept the note is the vault's canonical treatment of the facet
#
# RELABELED 2026-08-16 after the Gulati 2018 split. The 13,515-word monograph
# produced 58 of the 85 chunks under Sources/Language Deprivation/, so under the
# scholar persona's 2-chunk-per-source cap (BRAIN_SCHOLAR_MAX_PER_SOURCE,
# brain.py:261) the one correct passage competed with 57 siblings for 2 slots.
# It was split into a hub plus five balanced children. Four rows below named the
# monolith; they now name the child that actually holds the evidence, each
# confirmed by grepping the child for the evidence string in the row. The parent
# hub still exists and still holds Introduction / How Does LD Happen / Conclusion,
# so the old labels were not broken paths, just aimed at the wrong note: the
# children legitimately outrank the parent now, which is the whole point of the
# split and is why depth MRR read 0.768 -> 0.653 while note-level stayed 8/8.
# That number was measuring stale labels, not worse retrieval.
{"id": "depth_facet_definition", "set": "depth_gold", "persona": "scholar", "question": "What is the clinical definition of Language Deprivation Syndrome and what features constitute it?", "expect_sources": ["LanguageDeprivationAgent/Core/What Is Language Deprivation.md", "Sources/Language Deprivation/Hall Levin Anderson 2017 - Language Deprivation Syndrome.md"], "label_method": "body", "evidence": "Core note: 'proposes Language Deprivation Syndrome (LDS) as a neurodevelopmental disorder with sociocultural origins, characterized by:' followed by the five numbered features"}
{"id": "depth_facet_neurobiology", "set": "depth_gold", "persona": "scholar", "question": "What does neuroimaging show about the brains of people who acquired a first language late?", "expect_sources": ["LanguageDeprivationAgent/Core/Critical Period and Brain.md", "Sources/Language Deprivation/Gulati 2018 - LDS Neurobiology.md"], "label_method": "body", "evidence": "Gulati 'The Neurobiology of Language Deprivation': Mayberry fMRI non-migration to left-hemisphere areas; Penicaud VBM gray-matter reductions, 25% to 30% less in early-teen learners; ERP grammar-slow/meaning-normal. Core note: Cheng et al 2019 left dorsal arcuate fasciculus"}
{"id": "depth_facet_cognition", "set": "depth_gold", "persona": "scholar", "question": "How does early language deprivation affect theory of mind, executive function, and reasoning about time and cause?", "expect_sources": ["Sources/Language Deprivation/Gulati 2018 - LDS Cognitive Characteristics.md", "LanguageDeprivationAgent/Core/Bilingual Bimodal Protective Factors.md"], "label_method": "body", "evidence": "Gulati descriptor sections on time, cause-and-effect, theory of mind, incl. Ketelaar 72 implanted children and Tomasuolo three-school comparison. Core note: Schick/de Villiers/Hoffmeister 2007 and the no-executive-function-cost finding"}
{"id": "depth_facet_mental_health", "set": "depth_gold", "persona": "scholar", "question": "What is the psychiatric and public-health evidence base on language deprivation in deaf adults?", "expect_sources": ["LanguageDeprivationAgent/Core/Mental Health and Public Health.md", "Sources/Language Deprivation/Hall Levin Anderson 2017 - Language Deprivation Syndrome.md"], "label_method": "concept", "evidence": "Core note sections on Hall Levin Anderson 2017 (SPPE), Dinner Table Syndrome, ACEs, healthcare access and fund of information"}
{"id": "depth_facet_assessment", "set": "depth_gold", "persona": "scholar", "question": "How is language deprivation assessed and diagnosed, and what instruments and interpreter support does it require?", "expect_sources": ["LanguageDeprivationAgent/Parent Guidance/Language Milestones and Warning Signs.md", "Sources/Language Deprivation/Gulati 2018 - LDS Diagnosis and Treatment.md"], "label_method": "body", "evidence": "Milestones note 'Assessment instruments to ask for': ASL-CDI, VCSL. Gulati 'Making Psychiatric Diagnoses in People with LDS': more time, Certified Deaf Interpreter, ICD-10-CM F80.4 and the absence of formal criteria"}
{"id": "depth_facet_cochlear", "set": "depth_gold", "persona": "scholar", "question": "In what sense is language deprivation after cochlear implantation described as iatrogenic, and what are the competing plasticity hypotheses?", "expect_sources": ["LanguageDeprivationAgent/Core/Cochlear Implant Pathways and Risk.md", "Sources/Language Deprivation/Gulati 2018 - LDS and Cochlear Implantation.md"], "label_method": "body", "evidence": "Gulati 'The Role of Cochlear Implantation in Language Deprivation': iatrogenic framing, walking-implant thought experiment, Tobey et al 2012 one-third syntax, MCMP vs the Task-Selective Sensory-Independent model"}
{"id": "depth_facet_prevention_policy", "set": "depth_gold", "persona": "scholar", "question": "What policy and prevention instruments address language deprivation at population scale, and where does current compliance monitoring fall short?", "expect_sources": ["LanguageDeprivationAgent/Core/CRPD Article 24 and Sign Language Peoples.md", "Sources/Language Deprivation/Murray Hall Snoddon 2019 - Necessity of Signed Languages.md", "Concepts/Inclusive Education and LEAD-K Implementation.md"], "label_method": "concept", "evidence": "Core note on General Comment No. 4 (language of instruction, Deaf teachers structural, ages zero to five). Murray Hall Snoddon: WHO Bulletin public-health-necessity framing. LEAD-K note (added 2026-08-16) carries the General Comment No. 4 and LEAD-K compliance facts in its [!abstract] callout and retrieves at rank 1"}
{"id": "depth_facet_scholarly_debate", "set": "depth_gold", "persona": "scholar", "question": "What are the methodological criticisms of deaf-child research design and the open gaps in the language deprivation evidence base?", "expect_sources": ["LanguageDeprivationAgent/Core/Research Gaps.md", "Sources/Language Deprivation/Holcomb Hall et al 2025 - Challenging the Norm.md"], "label_method": "concept", "evidence": "Holcomb et al 2025: hearing-as-norm design under-justified, conflates audiological status with linguistic environment, within-deaf alternatives. Research Gaps: Caselli Hall Lillo-Martin 2017 operationalization, retrospective self-report, absent LDS diagnostic criteria"}
