# Open-access full-text resolver (research_oa.py). All optional.
# Contact email sent to Unpaywall and OpenAlex (polite-pool rate limits).
OA_MAILTO=you@example.com
# CORE (core.ac.uk) API key: higher rate limit; works without one.
CORE_API_KEY=
# Semantic Scholar API key: raises the ~1 req/s unauthenticated limit.
S2_API_KEY=
