[Unit]
Description=Jetson brain Ollama-API shim (Obsidian Smart Chat talks to the RAG unpatched)
Documentation=file:/mnt/nvme/brain/brain_ollama_shim.py
# Needs Ollama (the real one, on localhost:11434, is what brain.py generates
# with) and tailscaled (for the tailnet IP we bind to). Order after both;
# tailscaled must be up or the bind address does not exist yet.
After=network-online.target tailscaled.service ollama.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
# MUST run as snowbeach: brain.py's deps are installed with `pip install --user`,
# so root would not find them on the import path.
User=snowbeach
WorkingDirectory=/mnt/nvme/brain
# Wait until tailscaled has handed us an IPv4 tailnet address, then bind to it so
# Obsidian on the Mac reaches http://<tailscale-ip>:11435 directly. Resolving at
# startup (rather than hardcoding 100.x.x.x) means it survives an IP change.
# Drop the ExecStartPre and the env override to keep it on 127.0.0.1 instead.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/tailscale ip -4 >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/bin/sh -c 'exec env SHIM_HOST="$(/usr/bin/tailscale ip -4 | head -n1)" /usr/bin/python3 /mnt/nvme/brain/brain_ollama_shim.py'
Environment=PYTHONUNBUFFERED=1
# Port 11435, never 11434: the real Ollama owns 11434 and brain.py needs it.
Environment=SHIM_PORT=11435
# Web fallback off: vault-grounded answers only inside Obsidian.
Environment=SHIM_WEB=0
# Optional shared secret. Set it here and append /t/<token> to the "Ollama host"
# value in Smart Chat's settings - the plugin sends no headers on the chat
# request, so the token has to ride the URL path. Empty disables the check,
# which is fine on a tailnet-only bind.
# Environment=SHIM_TOKEN=changeme
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
