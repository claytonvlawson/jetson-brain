# groq.env.example -- copy to /mnt/nvme/brain/groq.env.local on the Jetson
# and fill in. Read by langchain_agent.py's cloud speed tier (see that
# file's module docstring for BRAIN_ROUTE_MODE / BRAIN_CLOUD_MODEL).
#
# Kept beside brain.py rather than under /etc like brave.env.example, since
# writing to /etc needs sudo and this only needs to be readable by the user
# that runs brain.py. Keep the real file chmod 600.
#
#   cp groq.env.example groq.env.local && chmod 600 groq.env.local
#   set -a && source groq.env.local && set +a
#   # get a key: https://console.groq.com/keys (generous free tier)

GROQ_API_KEY=replace-with-your-groq-api-key
