# brave.env.example -- copy to /etc/brave.env on the Jetson and fill in.
# Read by brain-web.service (EnvironmentFile, optional -- see the leading "-"
# on that unit's EnvironmentFile= line, so the service still starts fine if
# this file is absent and just falls back to DuckDuckGo). Keep the real file
# chmod 600.
#
#   sudo cp brave.env.example /etc/brave.env && sudo chmod 600 /etc/brave.env
#   # get a key: https://brave.com/search/api (free tier: 2,000 queries/month)
#
# advisor.service reads its own /etc/advisor.env instead -- add this same
# BRAVE_API_KEY line there too if you want the public advisor endpoint (with
# ADVISOR_WEB=1) to also use Brave.

BRAVE_API_KEY=replace-with-your-brave-search-api-key
